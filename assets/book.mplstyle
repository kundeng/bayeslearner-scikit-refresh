# Matplotlib style for the book
# Functional, grayscale-safe, publication-quality figures
# Usage: plt.style.use('assets/book.mplstyle')

# Figure
figure.figsize: 8, 5
figure.dpi: 150
figure.facecolor: white
figure.edgecolor: white
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.1

# Font
font.family: serif
font.serif: Latin Modern Roman, DejaVu Serif, Computer Modern
font.size: 11
mathtext.fontset: cm

# Axes
axes.facecolor: white
axes.edgecolor: 333333
axes.linewidth: 0.8
axes.grid: False
axes.titlesize: 13
axes.titleweight: bold
axes.labelsize: 11
axes.labelcolor: 1a1a2e
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['16537e', '9c4221', '2d6a4f', '6b21a8', '1a1a2e', '7f6d5f', '4a90d9', 'c0392b']) + cycler('linestyle', ['-', '--', '-.', ':', '-', '--', '-.', ':'])

# Grid
grid.color: cccccc
grid.linewidth: 0.5
grid.alpha: 0.5

# Lines
lines.linewidth: 1.8
lines.markersize: 6

# Ticks
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2
ytick.minor.size: 2
xtick.labelsize: 10
ytick.labelsize: 10

# Legend
legend.frameon: False
legend.fontsize: 10
legend.loc: best

# Scatter
scatter.marker: o
scatter.edgecolors: face
